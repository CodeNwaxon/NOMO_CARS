rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      // Replace with the CEO's actual User UID from Firebase Auth
      return request.auth != null && (
        request.auth.uid == 't5IY6nMxHJUg2jSakaOsAgQnqj42' ||
        exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid))
      );
    }

    function changingSensitiveFields() {
      let sensitiveFields = ['vipStars', 'vipExpiry', 'ticketExpiry', 'role', 'balance', 'isApproved', 'lastTicketPrice', 'lastTicketDays', 'totalEarnings', 'totalRides', 'rating'];
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(sensitiveFields);
    }

    // Default deny for any collections not explicitly matched (unless admin)
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      
      function isRegisteringAsDriver() {
        return request.resource.data.role == 'driver' && 
               request.resource.data.isApproved == false &&
               request.resource.data.isRejected == false;
      }
      
      allow update: if request.auth != null && (
        (request.auth.uid == userId && (!changingSensitiveFields() || isRegisteringAsDriver())) 
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favoriteCount'])
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jobsWon'])
      );
      
      match /favorites/{favoriteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Vehicles collection
    match /vehicles/{vehicleId} {
      // Any authenticated user can read vehicles (needed for duplicate plate checks & public profiles)
      allow read: if request.auth != null;
      
      // Vehicle creation is handled by the secure server action (Admin SDK).
      // Client-side create is denied to prevent malicious writes.
      allow create: if false;
      
      // Only the vehicle owner can update or delete it
      allow update, delete: if request.auth != null && resource.data.driverId == request.auth.uid;
    }

    // Vehicle Services collection
    match /vehicleServices/{serviceId} {
      // Anyone can read services
      allow read: if true;
      
      // Route creation is handled by the secure server action (Admin SDK).
      // Client-side create is denied to prevent malicious writes.
      allow create: if false;
      
      // Only the service owner can update or delete it
      allow update, delete: if request.auth != null && resource.data.driverId == request.auth.uid;
    }

    // Contact messages collection
    match /contact_messages/{messageId} {
      // Anyone can submit a contact message
      allow create: if true;
      
      // No one can read, update, or delete from the client side
      allow read, update, delete: if false;
    }

    // Chat system collection
    match /chats/{chatId} {
      // Allow read/update if user is in the participants array
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participants;
      
      // Allow create if user is in the new participants array
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        // Allow read/update if the user's uid is part of the chatId
        allow read, update: if request.auth != null && chatId.matches('.*' + request.auth.uid + '.*');
        
        // Allow sending a message if they are the sender AND their uid is part of the chatId
        allow create: if request.auth != null && 
          request.auth.uid == request.resource.data.senderId && 
          chatId.matches('.*' + request.auth.uid + '.*');
          
        // Allow users to delete ONLY their own messages
        allow delete: if request.auth != null && request.auth.uid == resource.data.senderId;
      }
    }

    // Reports collection
    match /reports/{reportedUserId} {
      // Allow any authenticated user to create or update a report using setDoc merge
      allow write: if request.auth != null;
      
      // No one can read reports from the client side (protect privacy)
      allow read: if false;
    }

    // Reviews collection
    match /reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if true;
      
      // Authenticated users can create a review if the userId matches their auth uid
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Only the user who wrote the review can update or delete it
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Admin Settings collection
    match /adminSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if request.auth != null 
                    && docId == 'notifications' 
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenReports']);
    }

    // Broadcasts collection
    match /broadcasts/{broadcastId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Admin Roles collection
    match /adminRoles/{adminId} {
      // Any authenticated user can read admin roles (needed for notification routing)
      allow read: if request.auth != null;
      // Only admins can modify roles
      allow write: if isAdmin();
    }

    // User Notifications collection
    match /user_notifications/{notificationId} {
      // Any authenticated user can create a notification for someone else
      allow create: if request.auth != null;
      // Users can only read, update, or delete their own notifications
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Visitors collection (Analytics)
    match /visitors/{visitorId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Transactions collection
    match /transactions/{transactionId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    match /users/{userId}/hiddenTransactions/{transactionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /requests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.passengerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.passengerId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.passengerId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bidCount'])
      );

      match /bids/{bidId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/requests/$(requestId)).data.passengerId == request.auth.uid ||
          bidId == request.auth.uid ||
          (resource != null && resource.data.driverId == request.auth.uid)
        );
        allow create: if request.auth != null && request.resource.data.driverId == request.auth.uid;
        allow update: if request.auth != null && resource.data.driverId == request.auth.uid;
        allow delete: if request.auth != null && resource.data.driverId == request.auth.uid;
      }
    }
  }
}
